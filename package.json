{
	"name": "philips-hue-remote",
	"private": true,
	"description": "Libraries and apps for controlling Philips Hue lights",
	"author": "janigowski <dawidjaniga@gmail.com>",
	"license": "MIT",
	"type": "module",
	"repository": {
		"type": "git",
		"url": "https://github.com/dawidjaniga/philips-hue-remote.git"
	},
	"workspaces": [
		"packages/*",
		"apps/*"
	],
	"scripts": {
		"build": "bun run --filter '*' build",
		"check": "bun run --filter '*' check",
		"test": "bun run --filter '*' test",
		"lint": "prettier --check . && bun run --filter '*' lint",
		"format": "prettier --write ."
	},
	"packageManager": "bun@1.4.2",
	"devDependencies": {
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^3.4.0",
		"prettier-plugin-tailwindcss": "^0.7.2"
	}
}
