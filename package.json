{
	"name": "philips-hue-remote",
	"private": true,
	"description": "Libraries and apps for controlling Philips Hue lights",
	"author": "janigowski <dawidjaniga@gmail.com>",
	"license": "MIT",
	"type": "module",
	"repository": {
		"type": "git",
		"url": "https://github.com/dawidjaniga/philips-hue-remote.git"
	},
	"workspaces": [
		"packages/*",
		"apps/*"
	],
	"scripts": {
		"build": "bun run --filter '*' build",
		"check": "bun run --filter '*' check",
		"test": "bun run --filter '*' test",
		"lint": "bun run --filter '*' lint",
		"format": "bun run --filter '*' format"
	},
	"packageManager": "bun@1.4.2"
}
