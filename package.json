{
	"name": "philips-hue-remote",
	"private": true,
	"description": "Libraries and apps for controlling Philips Hue lights",
	"author": "janigowski <dawidjaniga@gmail.com>",
	"license": "MIT",
	"type": "module",
	"repository": {
		"type": "git",
		"url": "https://github.com/dawidjaniga/philips-hue-remote.git"
	},
	"workspaces": [
		"packages/*",
		"apps/*"
	],
	"scripts": {
		"build": "vp run -r build",
		"check": "vp run -r check && tsc --noEmit -p scripts/codemods && bun run codemod:check",
		"test": "bun test scripts/codemods && vp run -r test",
		"lint": "vp fmt --check . && vp run --filter './apps/*' --filter './packages/*' lint",
		"format": "vp fmt .",
		"codemod": "bun scripts/codemods/run.ts",
		"codemod:check": "bun scripts/codemods/run.ts --check"
	},
	"packageManager": "bun@1.4.2",
	"devDependencies": {
		"@types/node": "^22",
		"svelte": "^5.46.1",
		"tailwindcss": "^4.1.17",
		"typescript": "^5.9.3",
		"vite": "catalog:",
		"vite-plus": "catalog:"
	},
	"catalog": {
		"@vitest/browser-playwright": "5.0.5",
		"vite": "npm:@voidzero-dev/vite-plus-core@1.3.0",
		"vitest": "5.0.5",
		"vite-plus": "1.3.0"
	},
	"overrides": {
		"vite": "catalog:",
		"vitest": "catalog:"
	}
}
