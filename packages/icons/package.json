{
	"name": "@huxel/icons",
	"version": "0.1.0",
	"description": "Typed icon sprite for Huxel",
	"private": true,
	"license": "MIT",
	"type": "module",
	"sideEffects": false,
	"exports": {
		".": "./src/index.ts",
		"./sprite": "./src/generated/sprite.ts",
		"./painted": "./src/generated/painted.ts",
		"./sprite.svg": "./src/generated/sprite.svg",
		"./mark.svg": "./src/mark.svg",
		"./package.json": "./package.json"
	},
	"scripts": {
		"build": "bun scripts/build.ts",
		"check": "bun scripts/build.ts --check && tsc --noEmit --pretty false",
		"test": "bun test",
		"lint": "tsc --noEmit --pretty false"
	},
	"devDependencies": {
		"@types/node": "^22",
		"typescript": "^5.9.3"
	}
}
