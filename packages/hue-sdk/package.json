{
	"name": "hue-sdk",
	"version": "0.1.0",
	"description": "Typed, environment agnostic TypeScript SDK for the Philips Hue CLIP API v2",
	"license": "MIT",
	"type": "module",
	"sideEffects": false,
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./package.json": "./package.json"
	},
	"types": "./dist/index.d.ts",
	"files": [
		"dist",
		"README.md",
		"CHANGELOG.md"
	],
	"engines": {
		"node": ">=18"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/dawidjaniga/philips-hue-remote.git",
		"directory": "packages/hue-sdk"
	},
	"keywords": [
		"philips-hue",
		"hue",
		"clip-v2",
		"smart-home",
		"typescript"
	],
	"scripts": {
		"build": "rm -rf dist && tsc -p tsconfig.build.json",
		"check": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
		"test": "vitest run --typecheck",
		"test:bun": "bunx --bun vitest run",
		"test:browser": "vitest run --config vitest.browser.config.ts",
		"check:universal": "sh scripts/check-universal.sh",
		"format": "prettier --write .",
		"lint": "prettier --check ."
	},
	"devDependencies": {
		"@types/lodash-es": "^4.17.12",
		"@types/node": "^22",
		"@vitest/browser-playwright": "^4.1.12",
		"playwright": "^1.64.1",
		"prettier": "^3.7.4",
		"typescript": "^5.9.3",
		"vitest": "^4.0.15"
	},
	"dependencies": {
		"lodash-es": "^4.18.1"
	}
}
