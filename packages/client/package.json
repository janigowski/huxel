{
	"name": "@huxel/client",
	"version": "0.2.0",
	"description": "Typed, environment agnostic TypeScript client for the Philips Hue CLIP API v2",
	"license": "MIT",
	"type": "module",
	"sideEffects": false,
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./package.json": "./package.json"
	},
	"types": "./dist/index.d.ts",
	"files": [
		"dist",
		"README.md",
		"CHANGELOG.md"
	],
	"engines": {
		"node": ">=18"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/janigowski/huxel.git",
		"directory": "packages/client"
	},
	"keywords": [
		"philips-hue",
		"hue",
		"clip-v2",
		"smart-home",
		"typescript"
	],
	"scripts": {
		"build": "vp pack",
		"check": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json && bun run check:universal",
		"test": "vp test run --typecheck",
		"test:bun": "bunx --bun vp test run",
		"test:browser": "vp test run --config vitest.browser.config.ts",
		"check:universal": "sh ../../scripts/check-universal.sh"
	},
	"devDependencies": {
		"@types/lodash-es": "^4.17.12",
		"@types/node": "^22",
		"@vitest/browser-playwright": "catalog:",
		"playwright": "^1.64.1",
		"publint": "^0.3.25",
		"typescript": "^5.9.3",
		"vite-plus": "catalog:",
		"vitest": "catalog:"
	},
	"dependencies": {
		"lodash-es": "^4.18.1"
	}
}
