{
	"name": "data-bus",
	"version": "0.1.0",
	"description": "Named signal-style values with a hidden publish/subscribe bus",
	"license": "MIT",
	"type": "module",
	"sideEffects": false,
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./svelte": {
			"types": "./dist/svelte/index.d.ts",
			"svelte": "./dist/svelte/index.js",
			"import": "./dist/svelte/index.js",
			"default": "./dist/svelte/index.js"
		},
		"./package.json": "./package.json"
	},
	"types": "./dist/index.d.ts",
	"files": [
		"dist",
		"README.md"
	],
	"engines": {
		"node": ">=18"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/dawidjaniga/philips-hue-remote.git",
		"directory": "packages/data-bus"
	},
	"keywords": [
		"event-bus",
		"signals",
		"pubsub",
		"svelte"
	],
	"scripts": {
		"build": "vp pack",
		"check": "tsc --noEmit && bun run check:universal",
		"test": "vp test run --typecheck",
		"check:universal": "sh ../../scripts/check-universal.sh"
	},
	"peerDependencies": {
		"svelte": "^5.7.0"
	},
	"peerDependenciesMeta": {
		"svelte": {
			"optional": true
		}
	},
	"devDependencies": {
		"@sveltejs/vite-plugin-svelte": "^7",
		"publint": "^0.3.25",
		"svelte": "^5.46.1",
		"typescript": "^5.9.3",
		"vite-plus": "catalog:",
		"vitest": "catalog:"
	}
}
