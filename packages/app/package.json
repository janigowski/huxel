{
	"name": "@huxel/app",
	"version": "0.1.0",
	"description": "Headless application state for Philips Hue lights, rooms, and zones",
	"license": "MIT",
	"type": "module",
	"sideEffects": false,
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./svelte": {
			"types": "./dist/svelte/index.d.ts",
			"svelte": "./dist/svelte/index.js",
			"import": "./dist/svelte/index.js"
		},
		"./react": {
			"types": "./dist/react/index.d.ts",
			"import": "./dist/react/index.js"
		},
		"./package.json": "./package.json"
	},
	"types": "./dist/index.d.ts",
	"files": [
		"dist",
		"README.md",
		"CHANGELOG.md",
		"banner.jpg"
	],
	"publishConfig": {
		"access": "public"
	},
	"engines": {
		"node": ">=18"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/janigowski/huxel.git",
		"directory": "packages/app"
	},
	"keywords": [
		"philips-hue",
		"hue",
		"signals",
		"headless",
		"svelte",
		"react"
	],
	"scripts": {
		"build": "vp pack",
		"check": "tsc --noEmit && bun run check:universal",
		"test": "vp test run",
		"check:universal": "sh ../../scripts/check-universal.sh"
	},
	"peerDependencies": {
		"react": ">=18.0.0",
		"svelte": "^5.7.0"
	},
	"peerDependenciesMeta": {
		"react": {
			"optional": true
		},
		"svelte": {
			"optional": true
		}
	},
	"dependencies": {
		"@preact/signals-core": "^1.14.4",
		"@huxel/client": "workspace:^"
	},
	"devDependencies": {
		"@sveltejs/vite-plugin-svelte": "^7",
		"@testing-library/dom": "^10.4.2",
		"@testing-library/react": "^16.3.3",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"happy-dom": "^21.0.4",
		"publint": "^0.3.25",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"svelte": "^5.46.1",
		"typescript": "^5.9.3",
		"vite-plus": "catalog:"
	}
}
