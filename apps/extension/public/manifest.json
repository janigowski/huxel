{
	"manifest_version": 3,
	"name": "huxel",
	"description": "Light control from your browser.",
	"version": "0.1.0",
	"minimum_chrome_version": "120",
	"icons": {
		"16": "icons/icon-16.png",
		"32": "icons/icon-32.png",
		"48": "icons/icon-48.png",
		"128": "icons/icon-128.png"
	},
	"action": {
		"default_icon": {
			"16": "icons/icon-16.png",
			"32": "icons/icon-32.png",
			"48": "icons/icon-48.png",
			"128": "icons/icon-128.png"
		},
		"default_title": "huxel//extension",
		"default_popup": "popup.html"
	},
	"permissions": ["storage"],
	"host_permissions": ["https://discovery.meethue.com/*"],
	"optional_host_permissions": ["https://*/*"]
}
